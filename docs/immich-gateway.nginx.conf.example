# Include inside the Immich HTTPS server block. Replace upstreams and secret.
# Require ngx_http_auth_request_module. The Zion upstream is private.
# Replace existing /api and /api/ locations rather than adding competing ones.
# Block direct public access to the Immich upstream port/firewall.
location = /_zion_access {
    internal;
    proxy_pass http://zion_private/internal/storage-access;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Zion-Gateway-Key "REPLACE_WITH_STORAGE_GATEWAY_KEY";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header x-api-key $http_x_api_key;
}
location = /api { return 308 /api/; }
location ~* ^/api(?:/|$) {
    auth_request /_zion_access;
    proxy_pass http://immich_private;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    client_max_body_size 0;
    proxy_read_timeout 600s;
}
# HTML/JS shell only; all actual API requests pass the gate above.
location / {
    proxy_pass http://immich_private;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
